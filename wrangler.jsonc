{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "vyasa-health-os",
  "type": "javascript",
  "main": "dist/index.js",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": "dist",
  "build": {
    "command": "npm run build",
    "cwd": "."
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "app.vyasaa.com",
          "zone_name": "vyasaa.com"
        }
      ]
    }
  }
}
