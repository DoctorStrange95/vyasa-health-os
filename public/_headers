# Never cache the HTML shell — it must always point at the current hashed assets
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Service worker must never be cached — browsers must always get the latest
# version so SW updates (and fixes) propagate immediately.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed assets are immutable — cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable
